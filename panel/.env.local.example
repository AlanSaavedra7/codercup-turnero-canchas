# Copiar a .env.local y completar con los datos del Bloque 1.
# .env.local NO se sube a git.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key

# URL del Chat Trigger de n8n. Es publica por diseno (la ve cualquiera que use
# el chat), por eso lleva NEXT_PUBLIC_. Sacala del nodo "When chat message
# received" -> campo "Chat URL". Si la dejas vacia, el panel funciona igual
# pero sin la burbuja de chat.
NEXT_PUBLIC_N8N_CHAT_URL=https://TU-NOMBRE.app.n8n.cloud/webhook/xxxxxxxx/chat
